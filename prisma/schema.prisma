// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js" // ← immer so!
}

datasource db {
  provider = "postgresql" // ← Neon = Postgres
  url      = env("DATABASE_URL") // ← GitHub Secret / .env(.production)
}

enum Role {
  ADMIN
  EMPLOYEE
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserPasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model InviteToken {
  id        String    @id @default(cuid())
  email     String
  role      Role
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // optional: welcher Admin hat eingeladen?
  invitedById String?
  invitedBy   User?   @relation("UserSentInvites", fields: [invitedById], references: [id], onDelete: SetNull)
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         Role        @default(EMPLOYEE)
  timeEntries  TimeEntry[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relationen mit eindeutigen Namen
  passwordResetTokens PasswordResetToken[] @relation("UserPasswordResetTokens")
  sentInvites         InviteToken[]        @relation("UserSentInvites")
}

// === NEU: Freigabe-Status ===
enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model TimeEntry {
  id            String          @id @default(cuid())
  user          User            @relation(fields: [userId], references: [id])
  userId        String
  workDate      DateTime
  startUtc      DateTime
  endUtc        DateTime
  durationMin   Int
  location      String?
  note          String?
  editedByAdmin Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  status        TimeEntryStatus @default(DRAFT)
  lockedAt      DateTime?

  @@index([userId, workDate])
  @@index([workDate])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String
  action    String
  diff      Json
  createdAt DateTime @default(now())
}
